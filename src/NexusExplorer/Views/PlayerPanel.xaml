<UserControl x:Class="NexusExplorer.Views.PlayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPlayerBg}">

    <Grid>
        <!-- 视频层:点击画面切换播放/暂停 -->
        <!-- HighQuality(双立方插值)缩放;NearestNeighbor 会产生锯齿 -->
        <Image x:Name="VideoImage"
               Visibility="Collapsed"
               Stretch="Uniform"
               Cursor="Hand"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="False"
               MouseLeftButtonUp="OnVideoAreaClick" />

        <!-- 图片层 -->
        <ScrollViewer x:Name="ImageScroll"
                      Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="Black"
                      MouseWheel="OnImageWheel">
            <Image x:Name="ImageDisplay"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Stretch="Uniform"
                   StretchDirection="DownOnly" />
        </ScrollViewer>

        <!-- 音频层:点击切换播放/暂停 -->
        <StackPanel x:Name="AudioLayer"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    Background="Transparent"
                    MouseLeftButtonUp="OnVideoAreaClick"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="🎵" FontSize="72" HorizontalAlignment="Center" Opacity="0.85" />
            <TextBlock x:Name="AudioTitle"
                       Style="{StaticResource TextOnPlayer}"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,18,0,0"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="500" />
        </StackPanel>

        <!-- 底部控制条:2 秒无操作自动隐藏(沉浸),鼠标移动/悬停恢复 -->
        <Border x:Name="ControlsBar"
                Background="#E6181818"
                VerticalAlignment="Bottom"
                BorderBrush="#33000000"
                BorderThickness="0,1,0,0"
                Padding="16,10"
                Opacity="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 进度 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText"
                               Grid.Column="0"
                               Text="0:00"
                               Style="{StaticResource TextOnPlayer}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <!-- 按下/松开事件在代码里 AddHandler(handledEventsToo) 挂载:
                         Slider 的 MoveToPoint 类处理会把 Preview 事件标记为已处理,
                         XAML 普通挂载收不到(进度条点击失效的根因) -->
                    <Slider x:Name="ProgressSlider"
                            Grid.Column="1"
                            Minimum="0" Maximum="1"
                            SmallChange="0.001" LargeChange="0.01"
                            IsMoveToPointEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="OnProgressChanged" />
                    <TextBlock x:Name="DurationText"
                               Grid.Column="2"
                               Text="0:00"
                               Style="{StaticResource TextOnPlayer}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </Grid>

                <!-- 按钮行 -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Style="{StaticResource ButtonOnPlayer}"
                            Content="⏮ 上一项" MinWidth="72"
                            Click="OnPrevious" />
                    <Button x:Name="PlayPauseButton"
                            Style="{StaticResource ButtonOnPlayer}"
                            Content="▶ 播放" MinWidth="80"
                            Click="OnPlayPause" />
                    <Button x:Name="StopButton"
                            Style="{StaticResource ButtonOnPlayer}"
                            Content="■ 停止" MinWidth="72"
                            Click="OnStop" />
                    <Button Style="{StaticResource ButtonOnPlayer}"
                            Content="⏭ 下一项" MinWidth="72"
                            Click="OnNext" />

                    <!-- 播放模式(音频) -->
                    <Button x:Name="ModeButton"
                            Style="{StaticResource ButtonOnPlayer}"
                            Content="➡ 顺序" MinWidth="88"
                            Click="OnCycleMode"
                            Visibility="Collapsed" />

                    <!-- 图片缩放 -->
                    <StackPanel x:Name="ZoomButtons"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <Button Style="{StaticResource ButtonOnPlayer}" Content="－"
                                Click="OnZoomOut" MinWidth="36" />
                        <Button Style="{StaticResource ButtonOnPlayer}" Content="＋"
                                Click="OnZoomIn" MinWidth="36" />
                        <Button Style="{StaticResource ButtonOnPlayer}" Content="1:1"
                                Click="OnZoomReset" MinWidth="46" />
                    </StackPanel>

                    <!-- 音量 -->
                    <StackPanel x:Name="VolumePanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="18,0,0,0">
                        <TextBlock Text="🔊" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider x:Name="VolumeSlider"
                                Width="90"
                                Minimum="0" Maximum="100"
                                SmallChange="1" LargeChange="10"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="OnVolumeChanged"
                                Value="80" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
