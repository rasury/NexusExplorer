<UserControl x:Class="NexusExplorer.Views.PlayerPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
 Background="{StaticResource BrushPlayerBg}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <vlc:VideoView x:Name="VideoView" Visibility="Collapsed">
   <Grid Background="#02000000" MouseLeftButtonUp="OnVideoAreaClick"/>
  </vlc:VideoView>
  <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
   Background="Black" SizeChanged="OnImageSizeChanged">
   <Image x:Name="ImageDisplay" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
    MouseWheel="OnImageWheel" MouseLeftButtonDown="OnImageMouseDown" MouseLeftButtonUp="OnImageMouseUp" MouseMove="OnImageMouseMove" Cursor="SizeAll"/>
  </ScrollViewer>
  <StackPanel x:Name="AudioLayer" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonUp="OnVideoAreaClick">
   <TextBlock Text="🎵" FontSize="72" HorizontalAlignment="Center"/>
   <TextBlock x:Name="AudioTitle" Style="{StaticResource TextOnPlayer}" FontSize="18" MaxWidth="500" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
  <Border x:Name="ControlsBar" Grid.Row="1" Background="#181818" Padding="12,8" Visibility="Collapsed">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="ProgressRow" Margin="0,0,0,8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PositionText" Text="0:00" Style="{StaticResource TextOnPlayer}" Margin="0,0,10,0"/>
     <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" ValueChanged="OnProgressChanged"/>
     <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Style="{StaticResource TextOnPlayer}" Margin="10,0,0,0"/>
    </Grid>
    <WrapPanel x:Name="MediaButtonsRow" Grid.Row="1" HorizontalAlignment="Center">
     <Button Style="{StaticResource ButtonOnPlayer}" Content="⏮ 上一项" Click="OnPrevious"/>
     <Button x:Name="PlayPauseButton" Style="{StaticResource ButtonOnPlayer}" Content="▶ 播放" Click="OnPlayPause"/>
     <Button Style="{StaticResource ButtonOnPlayer}" Content="■ 停止" Click="OnStop"/>
     <Button Style="{StaticResource ButtonOnPlayer}" Content="⏭ 下一项" Click="OnNext"/>
     <Button x:Name="ModeButton" Style="{StaticResource ButtonOnPlayer}" Content="➡ 顺序" Click="OnCycleMode"/>
     <TextBlock Text="🔊" VerticalAlignment="Center" Margin="8,0,4,0"/>
     <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="100" Value="100" IsMoveToPointEnabled="True" ValueChanged="OnVolumeChanged"/>
     <CheckBox x:Name="HardwareCheck" Content="硬件解码" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"
      ToolTip="关闭后使用软件解码；下次打开媒体生效" Checked="OnHardwareChanged" Unchecked="OnHardwareChanged"/>
     <Button Style="{StaticResource ButtonOnPlayer}" Content="音轨" Click="OnAudioTracks"/>
    </WrapPanel>
    <WrapPanel x:Name="ImageButtonsRow" Grid.Row="1" HorizontalAlignment="Center" Visibility="Collapsed">
     <Button Style="{StaticResource ButtonOnPlayer}" Content="⏮ 上一张" Click="OnPrevious"/>
     <Button Style="{StaticResource ButtonOnPlayer}" Content="＋" Click="OnZoomIn"/>
     <Button x:Name="ZoomResetButton" Style="{StaticResource ButtonOnPlayer}" Content="适合窗口" Click="OnZoomReset"/>
     <Button Style="{StaticResource ButtonOnPlayer}" Content="－" Click="OnZoomOut"/>
     <Button Style="{StaticResource ButtonOnPlayer}" Content="1:1" Click="OnZoomOriginal"/>
     <Button Style="{StaticResource ButtonOnPlayer}" Content="⏭ 下一张" Click="OnNext"/>
    </WrapPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
