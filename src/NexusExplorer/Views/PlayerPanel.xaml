<UserControl x:Class="NexusExplorer.Views.PlayerPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <md:Card x:Name="PreviewCard" Background="Black" UniformCornerRadius="16" md:ElevationAssist.Elevation="Dp0" ClipContent="True">
   <Grid Background="Black">
    <vlc:VideoView x:Name="VideoView" Background="Black" Visibility="Collapsed"><Grid x:Name="VideoClickSurface" Background="#02000000" MouseLeftButtonUp="OnVideoAreaClick"/></vlc:VideoView>
    <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Black" SizeChanged="OnImageSizeChanged">
     <Image x:Name="ImageDisplay" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" MouseWheel="OnImageWheel" MouseLeftButtonDown="OnImageMouseDown" MouseLeftButtonUp="OnImageMouseUp" MouseMove="OnImageMouseMove" Cursor="SizeAll"/>
    </ScrollViewer>
    <StackPanel x:Name="AudioLayer" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonUp="OnVideoAreaClick" Margin="24">
     <md:Card Width="128" Height="128" UniformCornerRadius="32" Background="{DynamicResource BrushAccentBlueLight}" md:ElevationAssist.Elevation="Dp0">
      <md:PackIcon Kind="MusicNote" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushOnPrimaryContainer}"/>
     </md:Card>
     <TextBlock x:Name="AudioTitle" Style="{StaticResource TextOnPlayer}" FontSize="22" Margin="0,24,0,0" MaxWidth="500" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </Grid>
  </md:Card>
  <md:Card x:Name="ControlsBar" Grid.Row="1" Style="{StaticResource PlayerCard}" Padding="16" Margin="0,16,0,0" Visibility="Collapsed">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="ProgressRow" Margin="0,0,0,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PositionText" Text="0:00" Style="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
     <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" ValueChanged="OnProgressChanged"/>
     <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Style="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>
    <WrapPanel x:Name="MediaButtonsRow" Grid.Row="1" HorizontalAlignment="Center">
     <Button Style="{StaticResource ButtonOnPlayer}" Click="OnPrevious" ToolTip="上一项"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="SkipPrevious" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="上一项" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="PlayPauseButton" Style="{StaticResource ButtonPrimary}" Click="OnPlayPause" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><md:PackIcon x:Name="PlayPauseIcon" Kind="Play" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock x:Name="PlayPauseLabel" Text="播放" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource ButtonOnPlayer}" Click="OnStop" ToolTip="停止"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="Stop" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="停止" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource ButtonOnPlayer}" Click="OnNext" ToolTip="下一项"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="SkipNext" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="下一项" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="ModeButton" Style="{StaticResource ButtonOnPlayer}" Click="OnCycleMode"><StackPanel Orientation="Horizontal"><md:PackIcon x:Name="ModeIcon" Kind="PlaylistPlay" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock x:Name="ModeLabel" Text="顺序" VerticalAlignment="Center"/></StackPanel></Button>
    </WrapPanel>
    <WrapPanel x:Name="MediaSettingsRow" Grid.Row="2" HorizontalAlignment="Center">
     <Grid Height="40" Margin="8,0,16,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="8"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
      <md:PackIcon x:Name="VolumeIcon" Kind="VolumeHigh" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource BrushSecondaryText}"/>
      <Slider x:Name="VolumeSlider" Grid.Column="2" Height="20" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="100" IsMoveToPointEnabled="True" ValueChanged="OnVolumeChanged"/>
     </Grid>
     <CheckBox x:Name="HardwareCheck" Content="硬件解码" Margin="0,0,16,0" VerticalAlignment="Center" ToolTip="关闭后使用软件解码；下次打开媒体生效" Checked="OnHardwareChanged" Unchecked="OnHardwareChanged"/>
     <Button Style="{StaticResource ButtonText}" Click="OnAudioTracks"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="Tune" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="音轨" VerticalAlignment="Center"/></StackPanel></Button>
    </WrapPanel>
    <WrapPanel x:Name="ImageButtonsRow" Grid.Row="1" HorizontalAlignment="Center" Visibility="Collapsed">
     <Button Style="{StaticResource ButtonOnPlayer}" Click="OnPrevious" ToolTip="上一张"><md:PackIcon Kind="SkipPrevious" Width="24" Height="24"/></Button>
     <Button Style="{StaticResource ButtonOnPlayer}" Click="OnZoomIn" ToolTip="放大"><md:PackIcon Kind="MagnifyPlusOutline" Width="24" Height="24"/></Button>
     <Button x:Name="ZoomResetButton" Style="{StaticResource ButtonSecondary}" Content="适合窗口" Click="OnZoomReset" Margin="0,0,8,8"/>
     <Button Style="{StaticResource ButtonOnPlayer}" Click="OnZoomOut" ToolTip="缩小"><md:PackIcon Kind="MagnifyMinusOutline" Width="24" Height="24"/></Button>
     <Button Style="{StaticResource ButtonOnPlayer}" Content="1:1" Click="OnZoomOriginal"/>
     <Button Style="{StaticResource ButtonOnPlayer}" Click="OnNext" ToolTip="下一张"><md:PackIcon Kind="SkipNext" Width="24" Height="24"/></Button>
    </WrapPanel>
   </Grid>
  </md:Card>
 </Grid>
</UserControl>
