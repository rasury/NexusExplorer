<UserControl x:Class="NexusExplorer.Views.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:NexusExplorer.Models"
             Background="{StaticResource BrushPanelBg}"
             BorderBrush="{StaticResource BrushDivider}"
             BorderThickness="0,1,0,0">

    <UserControl.Resources>
        <!-- 导航分类按钮:点击=导航下钻 -->
        <Style x:Key="NavCategoryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushAccentBlueLight}" />
            <Setter Property="Foreground" Value="{StaticResource BrushAccentBlue}" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyMain}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushAccentBlue}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushSecondaryBg}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushDisabledText}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 快捷分类按钮(第二层,钉):橙色系区分,当前选中的高亮 -->
        <Style x:Key="PinnedCategoryButton" TargetType="Button" BasedOn="{StaticResource NavCategoryButton}">
            <Setter Property="Background" Value="{StaticResource BrushAccentOrangeLight}" />
            <Setter Property="Foreground" Value="#B45F1D" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,4" />
            <Style.Triggers>
                <!-- 选中态由代码设置 Tag=true 时触发不了 style trigger,用 DataTrigger 绑定相对复杂,选中高亮在代码里换 Background -->
            </Style.Triggers>
        </Style>

        <!-- 绿色打勾确认按钮(两层共用) -->
        <Style x:Key="ConfirmButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF7D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyMain}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="把当前文件归入此分类" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushDisabledText}" />
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="ToolTip" Value="文件已在此分类中" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,8,14,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 第一层:当前路径 + 逐层导航 + 绿勾(共用) ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="当前分类:"
                           Style="{StaticResource TextCaption}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBlock Text="{Binding CurrentPathText}"
                           Style="{StaticResource TextPrimary}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!-- 面包屑(导航路径) -->
                    <ItemsControl x:Name="BreadcrumbHost"
                                  ItemsSource="{Binding Breadcrumb}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Category}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Name}"
                                            Style="{StaticResource NavCategoryButton}"
                                            Click="OnBreadcrumbClick"
                                            Tag="{Binding}" />
                                    <TextBlock Text="›"
                                               Style="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="2,0,8,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="RootBackButton"
                            Content="⌂ 顶层"
                            Style="{StaticResource NavCategoryButton}"
                            Click="OnBackToRoot"
                            Visibility="Collapsed" />

                    <!-- 当前层子分类 -->
                    <ItemsControl x:Name="ChildrenHost"
                                  ItemsSource="{Binding Children}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Category}">
                                <Button Content="{Binding Name}"
                                        Style="{StaticResource NavCategoryButton}"
                                        Click="OnCategoryClick"
                                        Tag="{Binding}"
                                        ContextMenuService.Placement="Top">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📌 钉到底栏快捷分类" Click="OnPinCategory" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 绿色打勾(两层共用) -->
            <Button x:Name="ConfirmButton"
                    Grid.Column="2"
                    Style="{StaticResource ConfirmButton}"
                    Content="✔"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"
                    Click="OnConfirmClick" />
        </Grid>

        <!-- ===== 第二层:快捷分类(钉) ===== -->
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="快捷:"
                       Style="{StaticResource TextCaption}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center">
                <ItemsControl x:Name="PinnedHost"
                              ItemsSource="{Binding PinnedCategories}"
                              Visibility="Visible">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Category}">
                            <Button Content="{Binding Name}"
                                    Style="{StaticResource PinnedCategoryButton}"
                                    Click="OnPinnedClick"
                                    Tag="{Binding}"
                                    ToolTip="点击选中此分类,然后按 ✔ 归类">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="✖ 取消钉住" Click="OnUnpinCategory" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空提示 -->
            <TextBlock x:Name="PinnedEmptyHint"
                       Grid.Column="1"
                       Text="在上方分类上右键可钉到这里"
                       Style="{StaticResource TextCaption}"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
