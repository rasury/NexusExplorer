<UserControl x:Class="NexusExplorer.Views.DocumentPreview"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" Background="{DynamicResource BrushPanelBg}">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="PreviewToggle" Content="排版预览" Style="{StaticResource ButtonText}" md:ButtonAssist.CornerRadius="10" Width="Auto" MinWidth="96" Height="40" Padding="8,0"
     Foreground="{DynamicResource BrushPrimaryText}" Background="{DynamicResource BrushAccentBlueLight}"
     ToolTip="切换 Markdown 排版预览与原文" Margin="8,0" Click="OnPreviewModeChanged"/>
    <ComboBox x:Name="EncodingBox" Width="140" Height="40" MinHeight="40" Padding="8,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="{StaticResource FontFamilyMain}"
     Foreground="{DynamicResource BrushPrimaryText}" SelectionChanged="OnEncodingChanged" ToolTip="文字乱码时可切换编码">
     <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
   </StackPanel>
   <TextBlock x:Name="DocumentTitle" Style="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <avalon:TextEditor x:Name="SourceEditor" IsReadOnly="True" FontFamily="{StaticResource FontFamilyMain}" FontSize="14"
    Background="{DynamicResource BrushPanelBg}" Foreground="{DynamicResource BrushPrimaryText}"
    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8"/>
   <FlowDocumentScrollViewer x:Name="MarkdownViewer" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
    Background="{DynamicResource BrushPanelBg}" Foreground="{DynamicResource BrushPrimaryText}"/>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,8,0,0">
   <Button x:Name="LoadMoreButton" DockPanel.Dock="Right" Content="加载更多" Style="{StaticResource ButtonText}" Click="OnLoadMore" Visibility="Collapsed"/>
   <TextBlock x:Name="DocumentStatus" Style="{StaticResource TextCaption}" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel>
 </Grid>
</UserControl>
