<UserControl x:Class="NexusExplorer.Views.FileRow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" IsHitTestVisible="False">
 <Grid Height="48"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border CornerRadius="10" Background="#167AADB9" Width="44" Height="44" ClipToBounds="True"><Grid>
   <md:PackIcon Kind="{Binding Extension, Converter={StaticResource FileMaterialIconConverter}}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushSecondaryText}"/>
   <Image x:Name="Cover" Stretch="UniformToFill"/>
  </Grid></Border>
  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
   <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="13"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TextPrimary}"><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource BrushAccentOrange}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <TextBlock x:Name="Metadata" FontSize="11" Foreground="{DynamicResource BrushSecondaryText}" Margin="0,4,0,0"/>
  </StackPanel>
 </Grid>
</UserControl>