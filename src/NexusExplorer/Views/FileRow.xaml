<UserControl x:Class="NexusExplorer.Views.FileRow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:views="clr-namespace:NexusExplorer.Views">
 <Grid Height="48"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
  <Border CornerRadius="10" Background="#167AADB9" Width="44" Height="44" ClipToBounds="True"><Grid>
   <md:PackIcon Kind="{Binding Extension, Converter={StaticResource FileMaterialIconConverter}}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushSecondaryText}"/>
   <Image x:Name="Cover" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,44,44" RadiusX="10" RadiusY="10"/></Image.Clip></Image>
  </Grid></Border>
  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
   <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="13"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TextPrimary}"><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource BrushAccentOrange}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <TextBlock x:Name="Metadata" FontSize="11" Foreground="{DynamicResource BrushSecondaryText}" Margin="0,4,0,0"/>
  </StackPanel>
  <Button x:Name="FavoriteButton" Grid.Column="2" Width="30" Height="30" VerticalAlignment="Center" Padding="0"
          Command="{Binding DataContext.FileListVmBinding.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type views:CategoryFilePanel}}}" CommandParameter="{Binding}">
   <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ClassicIconButton}">
    <Setter Property="Visibility" Value="Hidden"/><Setter Property="Foreground" Value="#888888"/><Setter Property="ToolTip" Value="收藏"/><Setter Property="AutomationProperties.Name" Value="收藏"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     <DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#E3AF27"/><Setter Property="ToolTip" Value="取消收藏"/><Setter Property="AutomationProperties.Name" Value="取消收藏"/></DataTrigger>
    </Style.Triggers>
   </Style></Button.Style>
   <md:PackIcon Kind="Star" Width="22" Height="22"/>
  </Button>
 </Grid>
</UserControl>
