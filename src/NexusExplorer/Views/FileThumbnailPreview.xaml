<UserControl x:Class="NexusExplorer.Views.FileThumbnailPreview"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
 <Border x:Name="PreviewSurface" Background="{DynamicResource BrushPanelBg}" Padding="0" BorderThickness="0">
  <Grid>
   <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
   <Grid x:Name="FallbackPanel" Width="240" MinHeight="128">
    <StackPanel Margin="16" VerticalAlignment="Center">
     <md:PackIcon x:Name="FallbackIcon" Kind="FileOutline" Width="56" Height="56" HorizontalAlignment="Center" Foreground="{DynamicResource BrushSecondaryText}"/>
     <TextBlock x:Name="PreviewStatus" Text="加载预览…" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
</UserControl>
