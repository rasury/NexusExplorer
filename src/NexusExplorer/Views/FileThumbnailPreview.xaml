<UserControl x:Class="NexusExplorer.Views.FileThumbnailPreview"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
 <StackPanel Width="320">
  <Grid>
   <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="240" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
   <md:PackIcon x:Name="FallbackIcon" Kind="FileOutline" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,16" Foreground="{DynamicResource BrushSecondaryText}"/>
  </Grid>
  <TextBlock x:Name="PreviewStatus" Text="加载预览…" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
 </StackPanel>
</UserControl>
