<Window x:Class="NexusExplorer.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:NexusExplorer.Views" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 Title="NexusExplorer" Icon="/NexusExplorer;component/Assets/AppIcon.ico" Width="1280" Height="880" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterScreen"
 Style="{StaticResource MaterialDesignWindow}" Background="{DynamicResource BrushPrimaryBg}" FontFamily="{StaticResource FontFamilyMain}" UseLayoutRounding="True">
 <md:DialogHost x:Name="RootDialog" Identifier="Nexus.Main" CloseOnClickAway="False" DialogContentUniformCornerRadius="28"
  DialogOpened="OnDialogOpened" DialogClosed="OnDialogClosed">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <md:ColorZone Mode="Standard" Background="{DynamicResource BrushSecondaryBg}" Padding="16,8">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button Style="{StaticResource IconButton}" Click="OnAppearanceClick" ToolTip="外观设置"><md:PackIcon Kind="PaletteOutline" Width="24" Height="24"/></Button>
     </StackPanel>
     <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="OnToggleDrawer" ToolTip="显示或隐藏分类面板" Margin="0,0,16,0"><md:PackIcon Kind="Menu" Width="24" Height="24"/></Button>
     <TextBlock Text="NexusExplorer" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryText}" VerticalAlignment="Center"/>
    </DockPanel>
   </md:ColorZone>
   <md:DrawerHost x:Name="NavigationDrawer" Grid.Row="1" OpenMode="Standard" IsLeftDrawerOpen="True" LeftDrawerCloseOnClickAway="False">
    <!-- Standard drawer measures across Auto rows; constrain its content to the viewport to preserve virtualization. -->
    <md:DrawerHost.LeftDrawerContent><views:CategoryFilePanel x:Name="LeftPanel" Width="360" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=md:DrawerHost}, FallbackValue=0}"/></md:DrawerHost.LeftDrawerContent>
    <views:PlayerPanel x:Name="PlayerArea" Margin="16"/>
   </md:DrawerHost>
   <md:ColorZone Grid.Row="2" Mode="Standard" Background="{DynamicResource BrushSecondaryBg}"><views:NavigationBar x:Name="NavBar"/></md:ColorZone>
   <md:Snackbar x:Name="TaskSnackbar" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" MaxWidth="560"/>
  </Grid>
 </md:DialogHost>
</Window>
