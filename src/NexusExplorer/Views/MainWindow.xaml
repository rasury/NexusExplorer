<Window x:Class="NexusExplorer.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:NexusExplorer.Views" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="NexusExplorer" Icon="/NexusExplorer;component/Assets/AppIcon.ico" Width="1360" Height="900" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterScreen"
 WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Style="{StaticResource MaterialDesignWindow}" Background="{DynamicResource BrushPrimaryBg}" FontFamily="{StaticResource FontFamilyMain}" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid x:Name="WindowSurface">
  <Grid x:Name="WallpaperScene" IsHitTestVisible="False" Background="Black"><Image x:Name="WallpaperImage" Source="/NexusExplorer;component/Assets/PrismBackground.png" Stretch="UniformToFill"/><Border x:Name="WallpaperShade" Background="{DynamicResource BrushWallpaperShade}"/></Grid>
  <md:DialogHost x:Name="RootDialog" Identifier="Nexus.Main" CloseOnClickAway="False" DialogContentUniformCornerRadius="24" DialogBackground="{DynamicResource BrushPrismDialog}" OverlayBackground="#20456775" DialogOpened="OnDialogOpened" DialogClosed="OnDialogClosed">
   <Grid x:Name="WindowLayout" Margin="6">
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel x:Name="TitleBar" Margin="16,0,4,0">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Style="{StaticResource IconButton}" Click="OnAppearanceClick" ToolTip="外观设置"><md:PackIcon Kind="PaletteOutline" Width="22" Height="22"/></Button>
      <Button Style="{StaticResource IconButton}" Click="OnMinimize" ToolTip="最小化" AutomationProperties.Name="最小化"><md:PackIcon Kind="Minus" Width="20" Height="20"/></Button>
      <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Click="OnMaximize" ToolTip="最大化" AutomationProperties.Name="最大化或还原"><md:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="18" Height="18"/></Button>
      <Button Style="{StaticResource IconButton}" Click="OnCloseWindow" ToolTip="关闭" AutomationProperties.Name="关闭"><md:PackIcon Kind="Close" Width="22" Height="22"/></Button>
     </StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="DrawerToggleButton" Style="{StaticResource IconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnToggleDrawer" ToolTip="显示或隐藏分类面板"><md:PackIcon Kind="Menu" Width="22" Height="22"/></Button>
      <TextBlock x:Name="AppTitle" Text="NexusExplorer" FontSize="23" FontWeight="SemiBold" Margin="12,0" Foreground="{DynamicResource BrushPrimaryText}" VerticalAlignment="Center"/>
     </StackPanel>
    </DockPanel>
    <Grid x:Name="Workspace" Grid.Row="1" Margin="20,8,-6,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid x:Name="LibrarySlot" Width="320" Margin="0,64,0,0" VerticalAlignment="Top">
     <views:PrismCard x:Name="LibraryCard" Width="300" HorizontalAlignment="Left" Padding="12,16" RenderTransformOrigin="1,0.5">
      <views:PrismCard.RenderTransform><TransformGroup><ScaleTransform x:Name="LibraryScale"/><TranslateTransform x:Name="LibraryTranslate"/></TransformGroup></views:PrismCard.RenderTransform>
      <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Margin="8,0"><Button x:Name="CreateRootCategoryButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="新建分类" AutomationProperties.Name="新建分类"><md:PackIcon Kind="Plus" Width="22" Height="22"/></Button><TextBlock Text="分类列表" Style="{StaticResource TextHeader}" VerticalAlignment="Center"/></DockPanel>
       <views:CategoryFilePanel x:Name="LeftPanel" Grid.Row="1"/>
      </Grid>
     </views:PrismCard></Grid>
     <Grid x:Name="CenterWorkspace" Grid.Column="1" Panel.ZIndex="1"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid HorizontalAlignment="Left" Width="{Binding PreviewSurfaceElement.ActualWidth, ElementName=PlayerArea}"><views:PrismCard x:Name="SearchCard" Padding="16,4" Height="46" MaxWidth="540" Margin="0,0,0,18" HorizontalAlignment="Stretch"><DockPanel><md:PackIcon Kind="Magnify" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource BrushSecondaryText}" Margin="0,0,12,0"/><Button x:Name="SearchScope" Height="30" VerticalAlignment="Center" Foreground="{DynamicResource BrushPrimaryText}" DockPanel.Dock="Right" Width="104" Margin="8,0,0,0" Click="OnSearchScopeClick" ToolTip="切换搜索范围" Background="Transparent" BorderThickness="0" Padding="0"><Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="12" Background="{DynamicResource BrushPrismSurface}" BorderBrush="{DynamicResource BrushPrismRim}" BorderThickness="1"><Grid ClipToBounds="True" Height="30"><Canvas x:Name="ScopeStrip" HorizontalAlignment="Stretch"><Canvas.RenderTransform><TranslateTransform x:Name="ScopeTranslate"/></Canvas.RenderTransform><TextBlock Canvas.Top="6" Text="当前分类" Width="104" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Canvas.Left="104" Canvas.Top="6" Text="全部分类" Width="104" TextAlignment="Center" VerticalAlignment="Center"/></Canvas></Grid></Border></ControlTemplate></Button.Template></Button><TextBox x:Name="FileSearch" MinHeight="0" Height="30" Padding="0" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" md:HintAssist.Hint="搜索当前分类文件…" TextChanged="OnSearchChanged" Foreground="{DynamicResource BrushPrimaryText}"><TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Center"/></ControlTemplate></TextBox.Template></TextBox></DockPanel></views:PrismCard></Grid>
      <views:PlayerPanel x:Name="PlayerArea" Grid.Row="1"/>
      <views:PrismCard x:Name="NavigationCard" Grid.Row="2" Margin="0,16,24,0" Padding="4"><views:NavigationBar x:Name="NavBar"/></views:PrismCard>
     </Grid>
    </Grid>
    <views:PrismCard x:Name="NoticeCard" Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="560" Margin="24,12,24,0" Padding="20,14" Visibility="Collapsed" IsHitTestVisible="False">
     <views:PrismCard.RenderTransform><TranslateTransform x:Name="NoticeTransform" Y="-160"/></views:PrismCard.RenderTransform><TextBlock x:Name="NoticeText" TextWrapping="Wrap" Style="{StaticResource TextPrimary}"/>
    </views:PrismCard>
   </Grid>
  </md:DialogHost>

 </Grid>
</Window>
