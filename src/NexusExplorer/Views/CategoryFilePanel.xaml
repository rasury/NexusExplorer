<UserControl x:Class="NexusExplorer.Views.CategoryFilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:NexusExplorer.Views"
             xmlns:models="clr-namespace:NexusExplorer.Models"
             AllowDrop="True"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PrismOverlayScrollViewer}"/>
        <!-- 分类树节点模板 -->
        <HierarchicalDataTemplate DataType="{x:Type models:Category}" ItemContainerStyle="{StaticResource PrismTreeItem}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Style="{StaticResource CategoryFolderIcon}" />
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- 文件列表项模板 -->
        <DataTemplate DataType="{x:Type models:FileItem}"><views:FileRow/></DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="CategoryFileLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- 分类树 -->
        <TreeView x:Name="CategoryTree" ItemContainerStyle="{StaticResource PrismTreeItem}"
                  Grid.Row="1"
                  Padding="8"
                  VirtualizingPanel.IsVirtualizing="True"
                  Loaded="OnListTopIndicatorLoaded"
                  ScrollViewer.ScrollChanged="OnListTopIndicatorScrollChanged"
                  AllowDrop="True"
                   MouseDoubleClick="OnCategoryDoubleClick"
                  ContextMenuOpening="OnCategoryTreeContextMenuOpening"
                  Drop="OnTreeDrop"
                  DragEnter="OnTreeDragEnter"
                  DragLeave="OnTreeDragLeave"
                  DragOver="OnTreeDragOver">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="在资源管理器中打开" Click="OnOpenCategoryInExplorer" />
                    <MenuItem Header="📌 钉到底栏" Click="OnPinCategory" />
                    <MenuItem Header="新建子分类" Click="OnCreateChild" />
                    <MenuItem Header="导入文件" Click="OnAddCategoryFiles" />
                    <MenuItem Header="导入文件夹" Click="OnAddCategoryFolder" />
                    <MenuItem x:Name="OrganizeCategoryMenu" Header="整理" Click="OnOrganizeCategory" ToolTip="整理此分类及全部子分类" />
                    <MenuItem x:Name="CancelOrganizeButton" Header="取消整理" Click="OnCancelOrganize" Visibility="Collapsed" />
                    <Separator />
                    <MenuItem Header="重命名" Click="OnRenameCategory" />
                    <MenuItem Header="重新定位目录…" Click="OnRelocateCategory" />
                    <MenuItem Header="迁移目录…" Click="OnMigrateCategory" />
                    <MenuItem Header="移到顶层" Click="OnMoveCategoryToRoot" />
                    <MenuItem Header="上移" Click="OnMoveCategoryUp" />
                    <MenuItem Header="下移" Click="OnMoveCategoryDown" />
                    <Separator />
                    <MenuItem Header="移除" Click="OnRemoveCategory" />
                    <MenuItem Header="删除" Click="OnDeleteCategory" Foreground="{DynamicResource BrushDanger}" />
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
        <Border x:Name="CategoryTopIndicator" Grid.Row="1" Height="3"
                VerticalAlignment="Top" Background="{DynamicResource BrushAccentBlue}"
                IsHitTestVisible="False" Visibility="Hidden" />

        <GridSplitter x:Name="CategoryFileSplitter" Grid.Row="2"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                      KeyboardIncrement="16" Cursor="SizeNS" Focusable="True"
                      Background="Transparent"
                      ToolTip="上下拖动调整分类和文件区域大小" AutomationProperties.Name="调整分类和文件区域大小">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Foreground" Value="{DynamicResource BrushDivider}" />
                    <Setter Property="Template"><Setter.Value>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="{TemplateBinding Background}">
                                <Border Width="40" Height="2" CornerRadius="1" Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value></Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource BrushAccentBlue}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource BrushAccentBlue}" /></Trigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <Grid Grid.Row="3" x:Name="FileArea">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <!-- 文件列表标题与列表一起调整高度 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BrushDivider}"
                    BorderThickness="0,1,0,1"
                    Padding="16,0">
                <TextBlock x:Name="FileCountHeader" Text="文件 · 0"
                           Style="{StaticResource TextCaption}" />
            </Border>

            <!-- 文件列表 -->
            <ListBox x:Name="FileListBox" ItemContainerStyle="{StaticResource PrismFileItem}"
                     Grid.Row="1"
                     Padding="8"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     Loaded="OnListTopIndicatorLoaded"
                     ScrollViewer.ScrollChanged="OnListTopIndicatorScrollChanged"
                     AllowDrop="True"
                      SelectionMode="Extended"
                     MouseDoubleClick="OnFileDoubleClick"
                     Drop="OnFilesDrop"
                     DragOver="OnFilesDragOver"
                      ContextMenuOpening="OnFileContextMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="在资源管理器中打开" Click="OnOpenFileInExplorer" />
                        <MenuItem x:Name="RelocateFileMenu" Header="重新定位…" Click="OnRelocateFile" />
                        <MenuItem x:Name="RenameFileMenu" Header="重命名…" Click="OnRenameFile" />
                        <Separator />
                        <MenuItem Header="从分类移除" Click="OnRemoveFile" />
                        <MenuItem Header="删除" Click="OnDeleteFile" Foreground="{DynamicResource BrushDanger}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <Border x:Name="FileTopIndicator" Grid.Row="1" Height="3"
                    VerticalAlignment="Top" Background="{DynamicResource BrushAccentBlue}"
                    IsHitTestVisible="False" Visibility="Hidden" />
        </Grid>
    </Grid>
</UserControl>
