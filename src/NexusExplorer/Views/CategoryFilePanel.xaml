<UserControl x:Class="NexusExplorer.Views.CategoryFilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:NexusExplorer.Models"
             AllowDrop="True"
             Background="{DynamicResource BrushSecondaryBg}">

    <UserControl.Resources>
        <!-- 分类树节点模板 -->
        <HierarchicalDataTemplate DataType="{x:Type models:Category}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Style="{StaticResource CategoryFolderIcon}" />
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- 文件列表项模板 -->
        <DataTemplate DataType="{x:Type models:FileItem}">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="{Binding Extension, Converter={StaticResource FileMaterialIconConverter}}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="FileNameText"
                           Text="{Binding FileName}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="FileNameText" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="FileNameText" Property="Foreground" Value="{DynamicResource BrushAccentOrange}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ExistsOnDisk}" Value="False">
                    <Setter TargetName="FileNameText" Property="Foreground" Value="{DynamicResource BrushDisabledText}" />
                    <Setter TargetName="FileNameText" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
        </Grid.RowDefinitions>

        <!-- One reserved status row; classification controls live in the header/context menu. -->
        <Border Grid.Row="0" Height="40" Background="{DynamicResource BrushPanelBg}" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <Button Style="{StaticResource ButtonText}" x:Name="CancelOrganizeButton" DockPanel.Dock="Right" Content="取消整理" Click="OnCancelOrganize" Visibility="Collapsed" Margin="8,0,0,0" />
                <TextBlock Style="{StaticResource TextCaption}" x:Name="OperationStatus" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </DockPanel>
        </Border>
        <!-- 分类树 -->
        <TreeView x:Name="CategoryTree"
                  Grid.Row="1"
                  Margin="0,0,0,8"
                  Padding="8"
                  VirtualizingPanel.IsVirtualizing="True"
                  Loaded="OnListTopIndicatorLoaded"
                  ScrollViewer.ScrollChanged="OnListTopIndicatorScrollChanged"
                  AllowDrop="True"
                   MouseDoubleClick="OnCategoryDoubleClick"
                  ContextMenuOpening="OnCategoryTreeContextMenuOpening"
                  Drop="OnTreeDrop"
                  DragEnter="OnTreeDragEnter"
                  DragLeave="OnTreeDragLeave"
                  DragOver="OnTreeDragOver">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="在资源管理器中打开" Click="OnOpenCategoryInExplorer" />
                    <MenuItem Header="📌 钉到底栏" Click="OnPinCategory" />
                    <MenuItem Header="新建子分类" Click="OnCreateChild" />
                    <MenuItem Header="添加文件" Click="OnAddCategoryFiles" />
                    <MenuItem Header="添加文件夹" Click="OnAddCategoryFolder" />
                    <MenuItem x:Name="OrganizeCategoryMenu" Header="整理" Click="OnOrganizeCategory" ToolTip="整理此分类及全部子分类" />
                    <Separator />
                    <MenuItem Header="重命名" Click="OnRenameCategory" />
                    <MenuItem Header="重新定位目录…" Click="OnRelocateCategory" />
                    <MenuItem Header="迁移目录…" Click="OnMigrateCategory" />
                    <MenuItem Header="移到顶层" Click="OnMoveCategoryToRoot" />
                    <MenuItem Header="上移" Click="OnMoveCategoryUp" />
                    <MenuItem Header="下移" Click="OnMoveCategoryDown" />
                    <Separator />
                    <MenuItem Header="移除" Click="OnRemoveCategory" />
                    <MenuItem Header="删除" Click="OnDeleteCategory" Foreground="{DynamicResource BrushDanger}" />
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
        <Border x:Name="CategoryTopIndicator" Grid.Row="1" Height="3"
                VerticalAlignment="Top" Background="{DynamicResource BrushAccentBlue}"
                IsHitTestVisible="False" Visibility="Hidden" />

        <!-- 分割线 + 文件列表标题 -->
        <Border Grid.Row="2"
                Background="{DynamicResource BrushPanelBg}"
                BorderBrush="{DynamicResource BrushDivider}"
                BorderThickness="0,1,0,1"
                Padding="16,0">
            <TextBlock Text="{Binding FileListVmBinding.HeaderText, Mode=OneWay}"
                       Style="{StaticResource TextCaption}" />
        </Border>

        <!-- 文件列表 -->
        <ListBox x:Name="FileListBox"
                 Grid.Row="3"
                 Padding="8"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 Loaded="OnListTopIndicatorLoaded"
                 ScrollViewer.ScrollChanged="OnListTopIndicatorScrollChanged"
                 AllowDrop="True"
                  SelectionMode="Extended"
                 MouseDoubleClick="OnFileDoubleClick"
                 Drop="OnFilesDrop"
                 DragOver="OnFilesDragOver"
                  ContextMenuOpening="OnFileContextMenuOpening">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="在资源管理器中打开" Click="OnOpenFileInExplorer" />
                    <MenuItem Header="重新定位…" Click="OnRelocateFile" />
                    <Separator />
                    <MenuItem Header="从分类移除" Click="OnRemoveFile" />
                    <MenuItem Header="删除" Click="OnDeleteFile" Foreground="{DynamicResource BrushDanger}" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
        <Border x:Name="FileTopIndicator" Grid.Row="3" Height="3"
                VerticalAlignment="Top" Background="{DynamicResource BrushAccentBlue}"
                IsHitTestVisible="False" Visibility="Hidden" />
    </Grid>
</UserControl>
